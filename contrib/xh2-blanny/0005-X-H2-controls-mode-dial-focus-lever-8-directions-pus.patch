+}
+
+const XH2_BANDS: &str = "X-H2 5.20 factory key-band table: configuration halfwords read through 0x148f2e8, \
+dumped in the emulator from configuration RAM 0x27008000 + offset. The sample is the band midpoint.";
+
+fn xh2_extension(options: &mut ladder_keys::Options) -> Result<(), String> {
+    let lever = options
+        .ladders
+        .iter_mut()
+        .find(|ladder| ladder.wire == ladder_keys::Wire::Adc { channel: 14 })
+        .ok_or("the X-H2 catalog ladders lack ADC 14")?;
+    // Focus-lever diagonals: table 0x1c38c20 rows for physical 0x2d..0x30
+    // (8DIR_R_U, 8DIR_R_D, 8DIR_L_U, 8DIR_L_D), decoder 0x13ff900.
+    let rung = |key, low, high| ladder_keys::Rung {
+        key,
+        band_low: low,
+        band_high: high,
+        sample: midpoint(low, high),
+        basis: XH2_BANDS.into(),
+    };
+    lever.rungs.extend([
+        rung(Key::StickUpRight, 100, 1230),
+        rung(Key::StickUpLeft, 1231, 1447),
+        rung(Key::StickDownRight, 1689, 1929),
+        rung(Key::StickDownLeft, 2220, 2605),
+    ]);
+    // Mode dial: scanner rows for physical 49..61 read ADC 3 against
+    // configuration halfwords 14072..14122 (UI MMOD_P .. FILTER).
+    options.dials = vec![ladder_keys::PositionDial {
+        name: "mode".into(),
+        aliases: vec![],
+        channel: 3,
+        positions: positions(&[
+            ("P", &[], 100, 462, false),
+            ("S", &[], 463, 768, false),
+            ("A", &[], 769, 1072, false),
+            ("M", &[], 1073, 1374, false),
+            ("C1", &[], 1375, 1677, false),
+            ("C2", &[], 1678, 1981, false),
+            ("C3", &[], 1982, 2289, false),
+            ("C4", &[], 2290, 2600, false),
+            ("C5", &[], 2601, 2918, false),
+            ("C6", &[], 2919, 3243, false),
+            ("C7", &[], 3244, 3576, false),
+            ("F", &["MOVIE"], 3577, 3921, false),
+            ("FILTER", &[], 3922, 4095, false),
+        ]),
+        basis: XH2_BANDS.into(),
+    }];
+    options.gpio_keys = vec![
                 shutter_half(
                     "0x1c52138: selector 0 (GPIO 0.0), released level 1, logical interrupt 1 (INTID 116); read helper 0x138331c.",
                 ),
                 shutter_full(
                     "0x1c52160: selector 1 (GPIO 0.1), released level 1, logical interrupt 2 (INTID 117); read helper 0x138331c.",
                 ),
-            ];
-            Ok(())
-        }
-        _ => Ok(()),
-    }
+        ladder_keys::GpioKey {
+            key: Key::StickPush,
+            pin: Pin { port: 15, pin: 6 },
+            active_high: false,
+            basis: "X-H2 5.20 focus-lever decoder 0x13ff900 reads GPIO 15.6 through 0x13ff8dc \
+(0x1377524(0xf0006)); while it reads low the lever state machine 0x13ffa88 reports the push (state 5, \
+physical 0x28) and ignores directions. Pressed = low."
+                .into(),
+        },
+        ladder_keys::GpioKey {
+            key: Key::RearPush,
+            pin: Pin { port: 0, pin: 13 },
+            active_high: false,
+            basis: "X-H2 5.20 scanner row for physical 0x3f reads GPIO 0.13 low; rear dial push by the \
+X-T5's wiring of the same pad (not confirmed on an X-H2)."
+                .into(),
+        },
+        ladder_keys::GpioKey {
+            key: Key::FrontPush,
+            pin: Pin { port: 0, pin: 14 },
+            active_high: false,
+            basis: "X-H2 5.20 scanner row for physical 0x3e reads GPIO 0.14 low; front dial push by the \
+X-T5's wiring of the same pad (not confirmed on an X-H2)."
+                .into(),
+        },
+    ];
+    Ok(())
 }
 
