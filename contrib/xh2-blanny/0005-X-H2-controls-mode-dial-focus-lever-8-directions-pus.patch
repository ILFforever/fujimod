 fn extension(body: &str, options: &mut ladder_keys::Options) -> Result<(), String> {
     match body {
         "xt5" => xt5_extension(options),
-        "xh2" => {
-            options.gpio_keys = vec![
+        "xh2" => xh2_extension(options),
+        _ => Ok(()),
