+kind = "write-only-registers"
+
+# The stage's loop 0xff801d24 stores 0x1ff to the word at +0xa0 of each of the 22 configuration banks
+# (0xfae00000 + 0x200 * n); the manifest declares only +0x20..+0x4c of each. Store-only latches.
