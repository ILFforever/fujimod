+byte_ns = 1000000
diff --git a/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/45-i2c2.toml b/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/45-i2c2.toml
new file mode 100644
