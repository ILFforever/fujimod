+++ b/catalog/firmware/xh2/5.33/xp5-boot/card-handoff.toml
@@ -0,0 +1,211 @@
+# Firmware entry after the mask ROM loads the SD card startup stage.
+pc = 0xff800000
+sp = 0xff83c000
+slot = 0xff9b0000
+stage_max_bytes = 0x3c000
+
+[power_controller_registers]
+"0" = 0x8202
+"10" = 0x0002
+
+# DDR PHY register space (0xfb000000, 0xfb400000) is RAM in the boot manifest; the stage's first
+# fault was a write at 0xfb04017a (PC 0xff80dfc8).
+
+# Memory-controller status the stock setup polls (0xfaf07780 non-zero, low byte of 0xfaf07784 a
+# result code) after writing 0xfaf07680. Scripted answers, as the X-T5's.
+
+[[device]]
+base = 0xfaf07000
+size = 0x1000
+kind = "bringup-stub"
+[device.options]
+registers = [{ offset = 0x780, mode = "constant", value = 1 }]
+
+[[device]]
+base = 0xfaf17000
+size = 0x1000
+kind = "bringup-stub"
+[device.options]
+registers = [{ offset = 0x780, mode = "constant", value = 1 }]
+
+[[device]]
+base = 0xfaf27000
+size = 0x1000
+kind = "bringup-stub"
+[device.options]
+registers = [{ offset = 0x780, mode = "constant", value = 1 }]
+
+[[device]]
+base = 0xfaf37000
+size = 0x1000
+kind = "bringup-stub"
+[device.options]
+registers = [{ offset = 0x780, mode = "constant", value = 1 }]
+
+# Memory-controller setup words the stock setup stores through its word writer 0xff80dfb8 and
+# never reads back (first fault: write at 0xfae60000, PC 0xff80dfbc). Store-only latches.
+
+[[device]]
+base = 0xfae60000
+size = 0x2000
+kind = "write-only-registers"
+
+[[device]]
+base = 0xfae63000
+size = 0x1000
+kind = "write-only-registers"
+
+[[device]]
+base = 0xfae70000
