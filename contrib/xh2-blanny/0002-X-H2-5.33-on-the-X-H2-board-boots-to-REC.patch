diff --git a/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/31-adc.toml b/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/31-adc.toml
new file mode 100644
index 00000000..d7f6781c
--- /dev/null
+++ b/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/31-adc.toml
@@ -0,0 +1,11 @@
+# ADC (the SoC's `adc` block). 0x140af08 -> 0x13aad30 -> 0x5e060 reads 15 channels at
+# 0xff906010 + 4*channel and caches them at 0x207aad8; channels 6, 13 and 14 feed the
+# OK/DISP/BACK, UP and joystick ladders, whose highest band ends at 3719, so 4095 holds
+# no key. Channel 0's 2713 is the X-T5 thermistor sample, INHERITED and UNVERIFIED on
+# the X-H2; the other values are no-key levels, not measured idle readings.
+[[device]]
+base = 0xff906000
+size = 0x1000
+kind = "adc"
+[device.options]
+samples = [2713, 4095, 4095, 4095, 4095, 4095, 4095, 4095, 4095, 4095, 4095, 4095, 4095, 4095, 4095]
diff --git a/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/32-gpio.toml b/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/32-gpio.toml
new file mode 100644
index 00000000..f2bd509d
--- /dev/null
+++ b/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/32-gpio.toml
@@ -0,0 +1,43 @@
+# GPIO (the SoC's `gpio` and `gpio3` blocks). The sampler 0x138331c reads input
+# 0xff907014 + 0x40*bank, except bank 3 at 0xff90b014; 0x1382d10 writes bank 0's +0x1c.
+[[device]]
+base = 0xff907000
+size = 0x1000
+kind = "gpio"
+[device.options]
+# EL1 handoff assumption: the two active-low panel selects on SSP7, GPIO 15.13 (rear LCD,
+# client 3) and 15.15 (EVF, clients 7 and 8), start inactive (output latch 1), as the
+# X-T5's 12.8 and 12.10 do. The selects are driven only through the serial descriptors'
+# select words; no code drives 15.15 before the first LCD transfer, so with a zero latch
+# both panels would be selected. Whether the reset image or a pull-up sets this is NOT
+# established. 15.11 (the audio codec) keeps a zero latch; its driver drives it first.
+initial_outputs = [{ port = 15, levels = 0xa000 }]
+# Run input: nothing in the hot shoe, as on the X-T5. The debounce 0x141ae50 (the X-T5's
+# 0x1416ba4) samples GPIO 11.4 (0x138331c(0xb0004) at 0x141b168) and latches (level == 1)
+# at 0x2592a64 after 17 differing samples, posting 0x2f for high and 0x82f for low; with
+# the latch at 1 the `flashext` identification 0x1412d64 opens SSP3 client 13 (instance 3,
+# select 11.4) for the external flash. The default pad level is 1, which would attach a
+# flash nobody modeled.
+initial_inputs = [{ port = 11, pin = 4, high = false }]
+# Sensor power drive is sensed back on GPIO 4.4 (body.json gpio_feedback:
+# sensor-power-enable -> sensor-power-sense), as on the X-T5. The secondary loader's port-4
+# row (0x3218, row 0xf798) makes 4.4 an output with its latch low; the imaging power-on
+# table 0x3865d80 drives it high through 0x30e36b4 (0x153b10c(1, 1)) and the power-off
+# table 0x3865c18 low through 0x30e37b0. The imaging startup 0x30a4df0 runs the receiver
+# initializer 0x30ecb64 only while the pad reads low (0x30e3ba8, signal table 0x1b02478
+# entry 1 = 0x40004); the bare pad reads high, so the initializer never ran and the REC
+# start's receiver control 0x2f7caf4 returned without arming the receivers.
+feedback = [{ port = 4, register = 0, bit = 4, input_port = 4, input_pin = 4 }]
+# Shutter release: S1 (half press) is GPIO 0.0 and S2 (full press) is GPIO 0.1, both active low
+# (scanner records 0x1c52138 and 0x1c52160: selectors 0 and 1, released level 1, logical interrupts
+# 1 and 2 = INTIDs 116 and 117; read helper 0x138331c; body.json connections controls-gpio-0-0 and
+# controls-gpio-0-1). The key scanner does not poll them for a press, so the pins raise those
+# interrupts, as on the X-T5 (xt5/4.31 30-power-input.toml). With them
+# declared the scanner's S1 row state (0x1c52159) reads 1 during an S1 hold (interactive run of
+# 2026-11-23); a static trace shows press by interrupt and release by polling on both bodies.
+input_irqs = [{ port = 0, pin = 0, line = 116, active_high = false }, { port = 0, pin = 1, line = 117, active_high = false }]
+
+[[device]]
+base = 0xff90b000
+size = 0x1000
+kind = "gpio-port3"
diff --git a/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/33-soc-temperature.toml b/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/33-soc-temperature.toml
