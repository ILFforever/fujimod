+# Power-gate bank (the SoC's `power-gates` block, declared as on the X-T5 and X100VI).
+# The domain switch 0x13af35c calls the latch writer 0x13b0088, which stores 0 or 1 to
+# +0x510 only (0x13b009c..0x13b00bc), between clock-gate adapter calls (0x13ad7e0 bank
+# 0xc = 0xff90c330, 0x13ad514 bank 0x11 = 0xff90c944, tables 0x18f4718/0x18f4688) and
+# the bus poll 0x13ad8dc (0xffa1b0f0 bit 0); it then clears or sets bits 0x700 of +0xb1c
+# and polls +0xb3c until they follow. The other gate users name +0xb00..+0xb10 with
+# status +0x20 above (e.g. 0x13a1630 +0xb10/+0xb30, 0x13c3a0c +0xb08/+0xb28), +0xb44/+0xb64
+# (0x13ca184) and +0xb50/+0xb70 (0x148f674, 0x14900b0, not modeled: they still refuse).
+# The shared model's latches start zero (session assumption); +0x510's effect is not
+# modeled (UNVERIFIED meaning).
+[[device]]
+base = 0xff90d000
+size = 0x1000
+kind = "power-gates"
