diff --git a/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/34-power-controller.toml b/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/34-power-controller.toml
new file mode 100644
index 00000000..9ed30a55
--- /dev/null
+++ b/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/34-power-controller.toml
@@ -0,0 +1,20 @@
+# Power controller on SPI2 (0xff912000), chip select GPIO 11.6 active-high: logical
+# serial descriptor 0x12 at 0x18ea480 is [2, 0xb0006, 1, 2, 0x20, ...] (instance 2,
+# select 11.6), where the X-T5's descriptor 19 selects SPI8 and 15.15. The reader
+# 0x13d805c and writer 0x13d8878 use the four-byte packet with the one's-complement
+# checksum of the shared power-controller part; the RTC getter 0x13d9214 combines
+# registers 0x23/0x24 and 0x27 bit 1 is calendar-valid. rtc_seconds is a virtual input
+# (seconds since 2000-01-01), not a captured value; source_hz is the X-T5 and X100VI
+# value, UNVERIFIED.
+[[device]]
+base = 0xff912000
+size = 0x1000
+kind = "spi-controller"
+[device.options]
+source_hz = 48000000
+[[device.options.endpoints]]
+select = { port = 11, pin = 6, active_high = true }
+[device.options.endpoints.part]
+kind = "power-controller"
+rtc_seconds = 0x325ffea2
+rtc_valid = true
diff --git a/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/42-hdmi.toml b/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/42-hdmi.toml
new file mode 100644
index 00000000..be0ef4af
--- /dev/null
+++ b/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/42-hdmi.toml
@@ -0,0 +1,17 @@
+# HDMI hot-plug status word, the X-T5, X100VI and X-H2S window and kind (xt5/4.31
+# 42-hdmi.toml). The reader 0x1445e74 (the X-T5's 0x143fb8c) returns bit 0 of 0xff90e200,
+# the only access to the block. 0x1446b4c (the X-T5's 0x1440864) drives the sink supply
+# low, waits 100 timer units (0x1496554), polls for bit 0 set (up to 101 polls, 5 units
+# apart) and then drives it high again; the boot step 0x1448284 (0x1441f9c) posts event
+# 0x17f5 when bit 0 is clear (0x144673c) or arms a 200-unit periodic poll (0x1446780)
+# that posts it once bit 0 clears. The X-T5 drives SoC GPIO 9.13 for the supply; the X-H2
+# drives bit 7 of an I2C port expander's port 1 (0x1407314(0x10000007, 0)), whose result
+# it ignores (0x1446b70), and the expander is not modeled. connected_level = 0 is the
+# X-T5's inference from that order, not measured. No cable is attached, as for the USB
+# status word.
+[[device]]
+base = 0xff90e200
+size = 4
+kind = "hdmi-hot-plug-status"
+[device.options]
+connected_level = 0
diff --git a/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/43-panel-serial.toml b/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/43-panel-serial.toml
new file mode 100644
index 00000000..7834363b
--- /dev/null
+++ b/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/43-panel-serial.toml
@@ -0,0 +1,31 @@
+# SSP instance 7 (0xff910000 + 7*0x1000) carries the two panels, as SSP5 does on the X-T5
+# (xt5/4.31 43-panel-serial.toml). The open routine 0x137e2d4 initializes the controller
+# from a client of the serial descriptor table (lookup 0x137f2a8: 0x18ea120 + 0x30*n) as
+# 0x137f3c4(instance, word 3, word 6, word 7, word 8, word 4, word 10): word 3 is the
+# pin-mux function (written to 0xff90c700), words 6 and 7 become CR0 bits 6 and 7
+# (0x137f354), word 8 is the word size and word 4 the prescaler. Clients:
+#   3 (0x18ea1b0): select GPIO 15.13 active-low, mux 1, CR0 bits 6/7 clear (mode 0),
+#     prescaler 0x10, 16-bit words:
+#     the rear LCD. The task `lcdevf` (entry 0x143d734) powers the LCD on through
+#     0x143fb80: the output link 0x1444c38, then 0x143f050, which opens the client
+#     (0x143e854) and writes the panel table 0x1997900. The driver keeps no reply.
+#   8 (0x18ea2a0): select GPIO 15.15 active-low, mux 3, mode 0, prescaler 0x14, 8-bit words:
+#     the EVF (0x1440870, 0x1441b44; string "EvfSd_NG" at 0x1999098), one register byte
+#     then data bytes. Client 7 (0x18ea270) is the same select with 16-bit words; its
+#     only user, the read 0x14422d0, is reached from the service handler 0x2d41804.
+# Neither panel part is identified, so both are FujiMod's write-only command/data
+# register endpoint: writes are retained, and a read is refused because the reply is
+# unknown. MISO during writes is discarded; miso_high = false is UNVERIFIED. source_hz
+# is the X-T5 and X100VI value, UNVERIFIED. The selects start inactive (32-gpio.toml).
+[[device]]
+base = 0xff917000
+size = 0x1000
+kind = "spi-controller"
+[device.options]
+source_hz = 48000000
+[[device.options.endpoints]]
+select = { port = 15, pin = 13, active_high = false }
+part = { kind = "serial-command-registers", bits = 16, mode = 0, miso_high = false }
+[[device.options.endpoints]]
+select = { port = 15, pin = 15, active_high = false }
+part = { kind = "serial-command-registers", bits = 8, mode = 0, miso_high = false }
diff --git a/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/44-i2c1.toml b/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/44-i2c1.toml
new file mode 100644
