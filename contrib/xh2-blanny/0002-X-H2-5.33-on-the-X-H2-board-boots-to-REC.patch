diff --git a/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/66-usb.toml b/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/66-usb.toml
new file mode 100644
index 00000000..3e1bfcae
--- /dev/null
+++ b/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/66-usb.toml
@@ -0,0 +1,54 @@
+# USB device controller and PHY of the X-H2 5.30 ff80 driver (0x2cbb774..): the same DesignWare
+# USB3 core, indexed USB2 PHY port, PHY/PLL control and completion stub as the X-T5 4.31
+# fragment, which this one copies at the SoC addresses. The driver's speed getter 0x2cbc91c
+# reads the shared `usb-connection-status` word and classifies 0xffc0c70c & 7, as the X-T5's
+# 0x2bfcd0c does. The interrupt number and the PHY/PLL control words are the X-T5's and are not
+# yet checked against this image's interrupt table.
+
+[[device]]
+base = 0xffc00000
+size = 0x10000
+kind = "usb-device-controller"
+[device.options]
+interrupt = 283
+speed = 0
+command_ticks = 1000
+transaction_ticks = 125000
+
+# Indexed USB2 PHY port, the XP4 protocol (X-T3 0xffb23800): index[12:8],
+# data[7:0], write strobe = rising edge of bit 16, readback at +0x400 (helper
+# 0x2bfae38). The parallel word at +0x04 is read-modify-written with masks
+# 0x70 (0x2bfc2f8) and 0x1 (0x2bfc310). Initial values are unknown; zeros.
+[[device]]
+base = 0xffc23800
+size = 0x404
+kind = "usb-phy"
+
+# ---------------------------------------------------------------------------------------------
+# Bring-up stubs, NOT models (same status as 49-gap-stubs.toml). The ff80 device init 0x2bfbb68
+# calls 0x13391f8(mode) at 0x2bfbd1c (also called by the host side, 0x14bcb5c). It toggles clock
+# gate bit 0x27 of 0xff90c918, then:
+#   0xffc10c08 |= 5                         (USB glue word; read-modify-write)
+#   0xffc30010 |= 0x10; 0xffc30008 = 0xffff (status clear); 0xffc30004 = 0x1003;
+#   0xffc30014 = mode word (bits 1:0 = 1, bit 2 = mode == 1, bit 4 set, bit 3 clear);
+#   poll 0xffc30008 until bits 1:0 != 0; bit 0 -> success, then 0x13391a8(1) sets
+#   0xffc30040 bits 3:0 = 0b0101 (0x13391a8(0) clears them on unplug).
+# The real block (a USB PHY/PLL control, unidentified; X100VI peripherals.md lists 0xffc10000 and
+# 0xffc30000 as unmodeled) is unknown. The completion below only answers the poll: the write of
+# +0x14 with bit 4 set "starts", and 100 us later +0x08 bit 0 is set; +0x08 is write-one-to-clear.
+[[device]]
+base = 0xffc10000
+size = 0x1000
+kind = "bringup-stub"
+[device.options]
+registers = []
+
+[[device]]
+base = 0xffc30000
+size = 0x1000
+kind = "completion-stub"
+[device.options]
+starts = [{ offset = 0x14, mask = 0x10 }]
+delay_us = 100
+completion = [{ offset = 0x08, set = 0x1 }]
+ack = { offset = 0x08, mode = "w1c", bits = 0x1 }
diff --git a/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/67-reset-handshake.toml b/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/67-reset-handshake.toml
new file mode 100644
index 00000000..3e13ebc7
--- /dev/null
+++ b/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/67-reset-handshake.toml
@@ -0,0 +1,14 @@
+# Reset handshake word (the shared `reset-handshake` model, declared as on the X-T5 and
+# X100VI). 0x1490798, called from 0x1492e30, calls 0x13ad210(0, 0x7f0003), stores 1 to
+# 0xff91c01c through 0x5de10 (0x14907b4..0x14907c0) and reads the same word through
+# 0x5de38 until it returns 0 (0x14907c4..0x14907d4); the X-T5's 0x148a854 has the same
+# sequence. Immediate completion is the siblings' functional assumption, not a camera
+# measurement (UNVERIFIED). The other routines that address this page (0x138aae0,
+# 0x138ab70, 0x138ac5c, 0x138acf8, 0x138ad34 and 0x138af98: instance 0 of a controller at
+# 0xff91c000 + 0x75000 * n, registers +0x4 to +0x28) are not modeled and keep refusing.
+[[device]]
+base = 0xff91c000
+size = 0x1000
+kind = "reset-handshake"
+[device.options]
+trigger_offset = 0x1c
diff --git a/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/68-audio-serial.toml b/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/68-audio-serial.toml
new file mode 100644
index 00000000..39da420b
--- /dev/null
+++ b/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/68-audio-serial.toml
@@ -0,0 +1,23 @@
+# SSP instance 8 (0xff910000 + 8*0x1000) carries the audio codec. Client 2 of the serial
+# descriptor table (lookup 0x137f2a8: 0x18ea120 + 0x30*n, n < 0x22) is 0x18ea180 =
+# [8, 0x000f000b, 0, 0, 0x18, ..., 0x10]: instance 8, select GPIO 15.11 active-low, mode
+# 0, prescaler 0x18, 16-bit words. The X-T5's client 2 (0x18e7c40) has the same fields
+# on instance 4 and select 12.7. Its only user 0x1490cac is the X-T5 codec driver
+# 0x148ad68 one-to-one (GPIO 15.3/15.4/15.5 for 12.0/12.1/12.2): one select period
+# carries a command word and a data word, bit 15 of the command marks a read whose
+# second reply is kept. Its callers are the stock task `audio` (task 0x43, name at
+# 0x19a2348, created by 0x1494f04 with entry 0x1492e30), which after the reset handshake
+# writes 12 pairs from 0x19a63e8 and 4133 from 0x19a2350, none with bit 15.
+# The codec part is not identified, so this is FujiMod's write-only command/data register
+# endpoint as on the X-T5: writes are retained and a read is refused because the reply
+# is unknown. MISO during writes is discarded by the driver; miso_high = false is
+# UNVERIFIED. source_hz is the X-T5 and X100VI value, UNVERIFIED.
+[[device]]
+base = 0xff918000
+size = 0x1000
+kind = "spi-controller"
+[device.options]
+source_hz = 48000000
+[[device.options.endpoints]]
+select = { port = 15, pin = 11, active_high = false }
+part = { kind = "serial-command-registers", bits = 16, mode = 0, read_flag = 0x8000, data_words = 1, miso_high = false }
diff --git a/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/69-lz.toml b/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/69-lz.toml
new file mode 100644
index 00000000..d7b0c935
--- /dev/null
+++ b/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/69-lz.toml
@@ -0,0 +1,20 @@
+# Lazy-code/font streaming DMA and conversion block (the SoC's `lz` block, the shared
+# `lz` model, declared as on the X-T5 and X100VI). 0x13a1630 powers it (gate 0xff90db10
+# bit 3, polled at 0xff90db30) and runs the reset handshake 0x13a1928 (write 0 to +0x00,
+# wait for nonzero, then for +0x24 == 0x10001), the X-T5's 0x139f9d0 word for word.
+# The stream setup 0x13a1978 (+0x40 = 0, address-high 0xff90e70c, +0x10..+0x1c, then
+# +0x20 = 0x84000400 and 0x94001400) and the page start 0x13a1a20 (address-high
+# 0xff90e708, +0x08, +0x0c, +0x04 = 1) equal the X-T5's 0x139fa20 and 0x139fac8; the
+# acknowledge words are +0x28 (0x13a1a80) and +0x68 (0x13a1acc, 0x148523c). The OSD
+# converter 0x14853a0 (reset 0x14852c8 polls +0x64 for 0x1010001) programs +0x40 = 1,
+# +0x48..+0x54 and +0x58/+0x5c/+0x60 = 0x400/0x4000400/0x1010001 before starting +0x44.
+# These are all the image's accesses to the page. The handlers 0x13a1538 and 0x148528c
+# attach to interrupt descriptors 0x8a (0x13a1734) and 0x71 (0x1485474) of the table
+# 0x18ece30 (lookup 0x13a137c); entries 0x18ed6d0 and 0x18ed540 both name INTID 201
+# (0xc9), the line the model raises. The model
+# also owns the address-high words 0xff90e708/e70c. Completion timing is the model's
+# functional assumption, not a camera measurement (UNVERIFIED).
+[[device]]
+base = 0xff980000
+size = 0x1000
+kind = "lz"
diff --git a/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/70-renderer.toml b/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/70-renderer.toml
new file mode 100644
index 00000000..afddf0be
--- /dev/null
+++ b/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/70-renderer.toml
@@ -0,0 +1,20 @@
+# SMAPH-H/OpenVG command renderer (the SoC's `renderer` block, the shared `renderer`
+# model, declared as on the X-T5 and X100VI). 0x15e76d8 sets the base word 0x27ac820 to
+# 0xff93c000 and read-modify-writes, through 0x15e74b4 (read helper 0x15e7470), +0x18c0,
+# +0x10c0, +0x10c4 = 0xffffffff, +0x1800, +0x1000, +0x1020 = 0, +0x1880, +0x10a0 =
+# 0x12345678, +0x18c0, +0x10c4 = 0xfffffff0, +0x1248 = 1, +0xc18, +0x1c = 0: the X-T5's
+# 0x15ddd0c sequence. The handler 0x15e7568 reads status +0x34 and acknowledges bit 31
+# (+0x1800, +0x1020), bit 30 (+0xc18) and bit 26 (+0x1c); 0x15e7684 attaches it to
+# interrupt descriptor 0x92 of the table 0x18ece30 (lookup 0x13a137c), whose row
+# 0x18ed750 names INTID 153 (0x99), the line the model raises. The driver
+# 0x15e7470..0x15e7e33 is the X-T5's 0x15ddaa4..0x15de467 instruction for instruction
+# apart from relocated global offsets; the register accessors 0x15e786c/0x15e7880 are
+# the only other callers of the helpers. The model also owns the address-high word
+# 0xff90e73c, which 0x147eb38 sets to bits 34..32 of the draw buffer around each draw
+# and clears afterwards, and 0x147e6c4 clears (the X-T5's 0x1478854 and 0x14783e0);
+# nothing else on the X-H2 declares it. DMA latency and the pixmap readback channel
+# order are the model's assumptions, not camera measurements (UNVERIFIED).
+[[device]]
+base = 0xff93c000
+size = 0x3000
+kind = "renderer"
diff --git a/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/71-display.toml b/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/71-display.toml
new file mode 100644
index 00000000..1ecfddf8
--- /dev/null
+++ b/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/71-display.toml
@@ -0,0 +1,48 @@
+# Display pixel-clock PLLs, declared as on the X-T5 and X100VI; they replace four banks
+# of 26-clock-banks.toml. The PLL base table 0x18f4638 (four-byte rows) holds
+# 0xffa11000..0xffa14000 at indices 6..9, the X-T5 table 0x18f2138's layout. The
+# programmers 0x1424664 and 0x1424730, the setup 0x1424874 and the pixel-clock query
+# 0x1424e14 are the X-T5's 0x141ed3c, 0x141ee08, 0x141ef4c and 0x141f4ec instruction for
+# instruction apart from immediates, and 0x1420c14 and 0x14211a4 call the setup before
+# the display reset (0x1420c34 before 0x1420cd4, 0x1421460 before 0x1421734). The N and
+# divider values come from the configuration the stock code reads, not from this file.
+[[device]]
+base = 0xffa11000
+size = 0x1000
+kind = "panel-pll"
+[[device]]
+base = 0xffa12000
+size = 0x1000
+kind = "panel-pll"
+[[device]]
+base = 0xffa13000
+size = 0x1000
+kind = "panel-pll"
+[[device]]
+base = 0xffa14000
+size = 0x1000
+kind = "panel-pll"
+
+# Display controllers, the X-T5 and X100VI windows and kind. 0x1433b04(n) resets
+# controller n (write 0 to +0x00 through 0x5de10, poll bit 0 through 0x5de38) at
+# 0xff990000 (n = 0) or 0xff9a0000 (n = 1); the status snapshot 0x1431a18 (called from
+# 0x14203f8) reads +0x08 first (0x1431ad4..0x1431adc). The driver is the X-T5's:
+# 0x1433b04, 0x1431a18, 0x142acd4, 0x142ad10, 0x142adb4, 0x142c074, 0x142c9a8,
+# 0x143b04c, 0x143b664 and 0x143b694 match 0x142dfa8, 0x142bebc, 0x1424c0c, 0x1424c48,
+# 0x1424cec, 0x1425fac, 0x14268e0, 0x14354e8, 0x1435b00 and 0x1435b30 instruction for
+# instruction; 0x143302c, 0x14336e0 and 0x143b6c4 differ only in global offsets; the
+# panel configuration 0x1436380 (0x1430824) writes the same offsets with this body's
+# panel constants. Every offset the image reads or writes in both windows
+# (+0x04..+0x7d0) is one the model accepts. 0x143e2ac attaches the handlers through
+# descriptors 0x8f, 0x90, 0x8d (controller 0) and 0x8b, 0x8c, 0x8e (controller 1) of
+# the table 0x18ece30 (rows 0x18ed6e0..0x18ed730): INTIDs 177, 178, 183 and 186, 187,
+# 192, the lines the model raises. The scanout geometry comes from the registers the
+# stock code programs.
+[[device]]
+base = 0xff990000
+size = 0x1000
+kind = "display"
+[[device]]
+base = 0xff9a0000
+size = 0x1000
+kind = "display"
diff --git a/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/72-update-uart.toml b/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/72-update-uart.toml
new file mode 100644
index 00000000..68259969
--- /dev/null
+++ b/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/72-update-uart.toml
@@ -0,0 +1,32 @@
+# UART port 0, an Arm PL011 at 0xff920000, for the stock firmware update program. The first
+# write the X-H2 5.30 update run made there is CR (+0x30) = 0 from the serial driver's port
+# setup (store from PC 0x5de10, the call at 0x1385974). The normal boot to REC never touches
+# the port.
+#
+# The X-H2 driver is the X-T5's (manifest of xt5-431, 65-uart.toml), checked by masked
+# instruction sequences: UART open 0x1383ba4 (X-T5 0x1381c10), register setup 0x13858e8
+# (0x1383954), divisors 0x1385300 (0x138336c), RL78 frame transfer 0x13d72b8 (0x13d4e8c),
+# frame builders and reply check 0x13d77e0/0x13d7628/0x13d7470/0x13d6694 (0x13d53b4/0x13d51fc/
+# 0x13d5044/0x13d484c), programming sequence 0x13d95b0 (0x13d766c; only GPIO pin ids differ),
+# install function 0x2e8d9c0 calling it at 0x2e8db68 (0x2dcb9c4; error 7 at 0x2e8eafc).
+# The serial configuration table 0x18eb4a0 and the interrupt records 0x18ece30 are byte-identical
+# to the X-T5's: port 0 at 115200, INTIDs 293..296.
+#
+# The peer is the virtual Renesas RL78 Protocol A programming target. What the program checks
+# in its replies: every frame starts 02, has the expected length, ends 03 or 17 with a correct
+# checksum; every status is 06 (a blank check may answer 1b, which makes it send an erase);
+# signature bytes 13..15 (code-flash end address) pick the image whose size is end + 1. Never
+# checked: the baud-set reply fields and the other signature bytes (device code, data-flash end,
+# version). Which size the real part reports is UNVERIFIED. The X-H2 update carries a 64 KiB and
+# a 48 KiB RL78 image (header entries 0 and 1); this declaration's 48 KiB flash selects the
+# 48 KiB one, an assumption carried over from the X-T5, not read from a camera. The program
+# also drives GPIO pins the X-T5's does not (0xa0004, and 0xa0005 where the X-T5 uses 0xf0002);
+# their roles are UNVERIFIED. The interrupt INTID 293 is the SoC's UART 0 as in the X-T5 table.
+[[device]]
+base = 0xff920000
+size = 0x1000
+kind = "pl011"
+
+[device.options]
+irq = 293
+rl78 = { flash_bytes = 0xc000 }
diff --git a/catalog/firmware/xh2/5.33/xp5-boot/manifest.toml b/catalog/firmware/xh2/5.33/xp5-boot/manifest.toml
new file mode 100644
index 00000000..77e60883
--- /dev/null
+++ b/catalog/firmware/xh2/5.33/xp5-boot/manifest.toml
@@ -0,0 +1,80 @@
+# Cold OS boot: EL3 -> EL1t handoff at 0x5847c, after stock 0x58420..0x58478
+# (the X-T5 4.31 kernel shape; loader tail 0x2318..0x232c passes x0 = [0x13008] =
+# 0x14e1c4c and x1 = 0x18250).
+version = 1
+firmware = "xh2-533"
+load_firmware = true
+# Host execution only: the companion computes (the IBIS servo's 16 kHz sample frames) far
+# more than it waits in delay loops, so it runs in block execution. The guest state is the
+# same either way.
+mprofile_block_execution = true
+
+# Device windows: manifest.d/*.toml, merged in filename order.
+
+# The body's DRAM extent: the stock bus-drain classifier 0x14d1a1c splits memory at
+# 0x80000000 (body hardware.bus_drain). PROVISIONAL: installed capacity is unmeasured.
+[[ram]]
+base = 0
+size = 0x80000000
+
+# The firmware uses DRAM past the body's 0x80000000: the still subject-detection arena is
+# 0x80001000+0x13ff000 (0x2e1f63c; the AI task 0x2ea34d8 clears 0x10c1000 bytes of it,
+# 0x2ea367c). The DDR setup 0x13af5a0 maps the four regions of the table 0x18f49f8 (mask
+# 0xf at 0x18f49f4): 0+0x80000000, 0x80000000+0x70000000, 0x100000000+0x80000000 and
+# 0x180000000+0x80000000. The drain helper's 0x80000000 read (0x14d1c44) therefore reads
+# RAM, as the X-T5's slot 1 does; the body's drain peripheral moves past the last region
+# only so that it does not overlap RAM. Installed capacity is unmeasured; the two regions
+# above 4 GiB are not declared until the firmware reaches them.
+[dram]
+limit = 0xf0000000
+bus_drain = 0x200000000
+
+[[ram]]
+base = 0x80000000
+size = 0x70000000
+
+# Companion SRAM, main view (the SoC's companion-sram region): 0x13fb120 copies the
+# companion image from flash 0xf01c0000 to 0xfa200000 and the shared configuration
+# lies at 0xfa2fa000..0xfa300000. Before that, the interrupt-configuration helper
+# 0x5dcd0 read-modify-writes 0xfa270e00 for INTIDs 0xf0..0xff.
+[[ram]]
+base = 0xfa200000
+size = 0x100000
+
+# Boot SRAM, 256 KiB. The SoC profile maps it only for ROM and SD starts, but the application
+# keeps the AE statistics banks here, as the X-T5 does: the AE setup 0x2f50bbc (X-T5 0x2e8c6b8)
+# stores the bank pointers 0xff800000 and 0xff8075a0 (0x2f50bf8, 0x2f50c00) with 0x75a0 bytes
+# each, 0x2f79de0 (0x2eb5e74) sets four planes 0x400 apart from 0xff80eb40 (0x2f79de8), and
+# 0x2eec5c4 (0x2e2943c) increments the counter 0xff82c008. The statistics model writes its
+# frames into this RAM.
+# DDR PHY register and firmware space, RAM as on the X-T5 (xt5/4.31 manifest.toml): the firmware
+# stores halfword PHY registers at 0xfb000000 / 0xfb400000 + 2 * APB index. The interactive run
+# of a half press stopped at write2 0xfb440120 (CPU0 PC 0x5de1c, LR 0x13bd4ec, the training drain
+# of 0x13bd764); the SD card start's stock setup also writes them (card-handoff.toml, 2026-11-23).
+# The mailbox pages above each region are the stubs of manifest.d/48-ddr-phy.toml. Plain RAM
+# is the X-T5's model; the X-H2's register meanings are UNVERIFIED.
+[[ram]]
+base = 0xfb000000
+size = 0x1a0000
+
+[[ram]]
+base = 0xfb400000
+size = 0x1a0000
+
+[[ram]]
+base = 0xff800000
+size = 0x40000
+
+# The SD slot (host 0xff9b0000, 25-sd.toml) is empty. The format describes the volume a
+# run that inserts a card without an image would see; it is unused while the slot is empty.
+[[sd]]
+base = 0xff9b0000
+present = false
+protected = false
+files = []
+[sd.format]
+sectors = 0x3b9e000
+max_dirty_sectors = 65536
+partition_start = 8192
+sectors_per_cluster = 64
+label = "NO NAME"
