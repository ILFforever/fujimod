@@ -0,0 +1,11 @@
+# Display output link, the X-T5 and X-H2S window and kind (xt5/4.31 24-output-link.toml).
+# 0x1444c38 (the X-T5's 0x143e964 apart from global offsets) reads +0x04 (0x1444cd0..
+# 0x1444cd8), writes +0x04, +0x08, +0x18, +0x0c, +0x10 and +0x14 from the tables
+# 0x1999c00..0x1999db8, then writes 0 to +0x00 and polls bit 0 (0x1444eec..0x1444f0c);
+# 0x1444fac (the X-T5's 0x143ecd8) read-modify-writes +0x04. Every access is a word in
+# +0x00..+0x18, all the model accepts; no interrupt handler names the block. The model
+# completes at once; its initial words of 0 are session assumptions.
+[[device]]
+base = 0xff9a1000
+size = 0x1c
+kind = "display-output-link"
diff --git a/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/25-sd.toml b/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/25-sd.toml
new file mode 100644
index 00000000..d29cfc61
--- /dev/null
+++ b/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/25-sd.toml
@@ -0,0 +1,54 @@
+# SD host instance 0, the X-H2's SD slot, in the X-T5 layout (xt5/4.31 25-sd.toml): the
+# UHS-I SDH30 port at +0, its register-selection words at +0x1e0, the UHS-II PHY block at
+# +0x2000 and the UHS-II port at +0x2200. The per-slot initialization 0x13a8064 (the X-T5's
+# 0x13a636c) builds (slot << 14) + 0xff9b2080 (0x13a8138..0x13a813c) and read-modify-writes
+# PHY +0x80 (0x13a8148..0x13a8154). The driver references 0xff9b0000, 0xff9b2000 and
+# 0xff9b4000 from 83, 73 and 1 sites, the X-T5's counts, and its register accesses are the
+# X-T5's: 0x13a923c, 0x13a8a08, 0x13a9c80, 0x13a9d20, 0x13a83fc, 0x13a9c04, 0x13a8a6c,
+# 0x13a9fcc, the clock ladder 0x13a90b4 and the interface clock configuration 0x13a8e5c match
+# 0x13a75fc, 0x13a6dbc, 0x13a8040, 0x13a80e0, 0x13a67b0, 0x13a7fc4, 0x13a6e20, 0x13a838c,
+# 0x13a7474 and 0x13a7210 apart from branch targets and globals; 0x13a8064, its caller
+# 0x13a8260 and the interrupt registration 0x13a60c4 differ only in clock-gate resource ids
+# and in dropping slot 1. Instance 1 is not declared: its only reference, 0xff9b403e in the
+# driver-strength setter 0x13a955c, has no caller, and 0x13a60c4 registers sources 0x84 and
+# 0x85 (INTIDs 262 and 267, rows 0x18ed670/0x18ed680 of the table 0x18ece30) for slot 0
+# only. Card presence is the [[sd]] run input in manifest.toml.
+#
+# Session assumptions, as on the X-T5 and X-H2S: transfer_ticks, clock_ticks and rca;
+# capabilities sets only bit 35 (UHS-II support), the only bit the driver reads (0x13a9fcc,
+# +0x2244 bit 3). ram_bytes is this run's DRAM limit; DRAM at 0x40000000 is separate, so no
+# XP4-style alias. No interrupt line is declared: the boot polls, and an asserted interrupt
+# refuses.
+
+[[device]]
+base = 0xff9b0000
+size = 0x1e0
+kind = "sdhci"
+[device.options.controller]
+base = 0xff9b0000
+protocol = "sdhc"
+transfer_ticks = 1000
+clock_ticks = 1000
+rca = 1
+ram_bytes = 0x80000000
+dram_alias = false
+# DMA address bits 34..32 of slot 0, port 0: the writer 0x13aaae0 (the X-T5's 0x13a8ea0)
+# stores (buffer >> 32) & 7 at 0xff90e7d8 + slot * 12 before each block transfer.
+address_high = 0xff90e7d8
+# The X-T5's stock clock steps: the ladder 0x13a90b4 and the interface clock configuration
+# 0x13a8e5c are its 0x13a7474 and 0x13a7210.
+speed_dividers = { interface = 2, default_speed = 4, high_speed = 2 }
+
+[[device]]
+base = 0xff9b01e0
+size = 8
+kind = "sd-interface"
+
+[[device]]
+base = 0xff9b2000
+size = 0x300
+kind = "sdhci-uhs2"
+[device.options]
+slot = 0xff9b0000
+capabilities = 0x800000000
+clock_ticks = 1000
diff --git a/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/26-clock-banks.toml b/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/26-clock-banks.toml
