diff --git a/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/55-develop.toml b/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/55-develop.toml
new file mode 100644
index 00000000..7383448c
--- /dev/null
+++ b/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/55-develop.toml
@@ -0,0 +1,52 @@
+# Live-view develop blocks, the X-T5's (xt5/4.31/xp5-boot/manifest.d/57-develop-stubs-3.toml),
+# with the same offsets, poll bits and interrupt numbers. Completion delays are functional,
+# not measured.
+
+# Filter scaler. Driver 0x148e56c (X-T5 0x1488264) builds the base at 0x13c0f98; MOVDC starts
+# it from 0x2f740bc and 0x2f742f0 (0x2eafcc8, 0x2eafefc). Reset 0x148e638 (0x1488330) writes
+# +0x0 and polls bit 0; stop 0x148e988 (0x1488680) waits for +0x100 bits 24 and 8 (0x13c1940,
+# 0x13c1950); start 0x148e9e4 (0x14886dc) writes +0x04 = 1 and 0x148ea04 (0x14886fc) writes the
+# interrupt enable +0x10c = 7. The handler 0x148f6d0 (0x14893c8) reads +0x104 and acknowledges
+# 7 at +0x108. Logical interrupt 0xb is level INTID 204 (table 0x18ece30).
+[[device]]
+base = 0xff983000
+size = 0x1000
+kind = "imaging-filter-scaler"
+[device.options]
+registers = [
+  { offset = 0x000, mode = "constant", value = 0x1 },
+  { offset = 0x100, mode = "constant", value = 0x01000100 },
+]
+irq = 204
+starts = [{ offset = 0x04, mask = 0x1 }]
+delay_us = 200
+completion = [{ offset = 0x104, set = 0x1 }, { offset = 0x04, clear = 0x1 }]
+ack = { offset = 0x108, mode = "w1c", status_offset = 0x104, bits = 0x7 }
+irq_mask_offset = 0x10c
+irq_mask_bit = 0
+irq_mask_set_masks = false
+
+# MIX. Driver 0x2d07f48..0x2d0a7ec (X-T5 0x2c46c20..0x2c494c4); the MOVDC wrapper 0x2f732dc
+# (0x2eaeee8) opens, sets, starts and stops it. The setter writes +0x0c at 0x2d095d0 (base
+# 0xffd2200c from 0x2d095c8). Reset 0x2d08420 (0x2c470f8) writes +0x0 = 0 and polls bit 0;
+# start setup 0x2d08ec4 (0x2c47b9c) and stop 0x2d09088 (0x2c47d60) test +0x208 bits 16 and 0
+# (0x2d08edc); the last start write is +0x04 = 1 (0x2d09078). The handler 0x2d08474 (0x2c4714c)
+# acknowledges +0x210 = 1 without a status read. Logical interrupt 0x19 is level INTID 213.
+# A completion stub, not a model of the mixer.
+[[device]]
+base = 0xffd22000
+size = 0x1000
+kind = "completion-stub"
+[device.options]
+registers = [
+  { offset = 0x000, mode = "constant", value = 0x1 },
+  { offset = 0x208, mode = "constant", value = 0x10001 },
+]
+irq = 213
+starts = [{ offset = 0x04, mask = 0x1 }]
+delay_us = 200
+completion = [{ offset = 0x210, set = 0x1 }, { offset = 0x04, clear = 0x1 }]
+ack = { offset = 0x210, mode = "w1c" }
+irq_mask_offset = 0x20c
+irq_mask_bit = 0
+irq_mask_set_masks = false
diff --git a/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/60-mcore.toml b/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/60-mcore.toml
new file mode 100644
index 00000000..b70e5652
--- /dev/null
+++ b/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/60-mcore.toml
@@ -0,0 +1,18 @@
+# Companion mailbox (the SoC's `mailbox` block): main 0xff90e100..0xff90e120 is the
+# companion's 0x5f90e100..0x5f90e120 (main INTID 142, companion NVIC line 55). The main
+# initializer 0x13fb120 clears it and copies the companion image from flash 0xf01c0000
+# into the SRAM RAM region at 0xfa200000 before setting release bit 21 of 0xff90c928.
+[[device]]
+base = 0xff90e100
+size = 0x24
+kind = "interprocessor-mailbox"
+
+# USB cable/jig connection status in bit 0: OTG initialization 0x14fe42c (called from
+# 0x14fee74) latches it into 0x27303a4 and, only when it is set, reads controller
+# register 0xe and posts event 0x3046; 0x2cbc91c reads it with 0xffc0c70c, and
+# 0x2cbc8fc and 0x2f13144 read bit 0 alone. The default input is disconnected, as on
+# the X-T5 and X100VI.
+[[device]]
+base = 0xff90e300
+size = 4
+kind = "usb-connection-status"
diff --git a/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/61-input-capture.toml b/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/61-input-capture.toml
new file mode 100644
index 00000000..387648eb
--- /dev/null
+++ b/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/61-input-capture.toml
@@ -0,0 +1,47 @@
+# Input-capture banks (the SoC's `capture0` and `capture1` blocks: five channels at
+# ff928000, three at ff929000, stride 0x20).
+[[device]]
+base = 0xff928000
+size = 0x1000
+kind = "input-capture"
+
+# Transmit DMA: the companion's capture object 0x319dc (returned by 0x2366c) names
+# channel 5. 0x237cc maps it to bank 1 index 0 (0x23684, 0x236b4) and returns its data
+# register 0x5f928004 + ((index + 128 * bank) << 5) = 0x5f929004, which the setup at
+# 0x3cde..0x3ce6 rebases to 0xff929004 as the destination of descriptor 2 (0x1ff0c(2) at
+# 0x3ca8): 0x31684 = [04 23 02 ...], channel 4 with request 35. The source is the table
+# at the driver state + 0x3c (local 0x340dc), 0xa4 bytes (0xa8 when the flag at 0xfa0ad
+# is set), built once by 0x3894 (0x3b32..0x3c7a) and submitted through 0x1ef84. The X-T5
+# and X100VI companions run the same routines on capture channel 2 (objects 0x323d0,
+# 0x37448) with descriptor [04 20 02 ...], request 32.
+[[device]]
+base = 0xff929000
+size = 0x1000
+kind = "input-capture"
+[device.options]
+dma_transmit = [{ channel = 0, request = 35 }]
+# IBIS stage position sensor behind capture channel 5. Every servo tick (0x1dd16) 0x3dc8
+# arms the capture interrupt and restarts the DMA of the 41-word table at 0x340dc; it is
+# the X-T5's table word for word apart from bits 31..29. Descriptor 0x45 of the table at
+# 0x31180 (0x3c9a..0x3ca2) names NVIC line 63 (0x315d0); handler 0x31f8 acknowledges
+# +0xc & 0x10001 and reads one capture from +0x10 per interrupt, the first carrying axes 0
+# and 1 (high, low), the second axis 2 (low), into 0x45b60..0x45b64. The servo linearizes
+# each raw sample as (raw - center) * gain >> 8 with centers 0x8000 (0xf6bb0) and gains
+# -256 (0xf6bb6), so 0x8000 is stage position zero. rest = 0: the stage held centered
+# while the body is still. latency_ns and lag_shift are the X-T5's scenario inputs, not
+# X-H2 measurements.
+[device.options.sequencer]
+channel = 0
+companion_irq_line = 63
+latency_ns = 20000
+center = [32768, 32768, 32768]
+rest = [0, 0, 0]
+lag_shift = 2
+# Coil drive: the servo stores its duty words 0xf6e74/78/7c (0x2ac14, 0x2aca8, 0x2ad44)
+# and writes them as the second compares of extended-timer channels 2, 4 and 0
+# (0x22e06..0x22e2e), whose first compares are 872 of period 1744 (0x22bfc..0x22c1e), as on
+# the X-T5. The servo's drive compensation (0x24de0) implies axis polarity +, +, -, the
+# X-T5's signs; the size is the X-T5's scenario input. Without the drive the stage cannot
+# follow the servo, whose command winds up to its limit.
+drive_channels = [2, 4, 0]
+drive_gain = [6, 6, -3]
diff --git a/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/62-companion-serial.toml b/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/62-companion-serial.toml
new file mode 100644
index 00000000..15583447
--- /dev/null
+++ b/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/62-companion-serial.toml
@@ -0,0 +1,65 @@
+# Companion serial controller: SSP instance 5 (the SoC's `spi5`). The companion's serial
+# setup at 0x3894 takes its instance from descriptor 0x316f8 (first word 5; the X-T5
+# companion's descriptor holds 1, its other words are the same) and builds
+# (instance + 0x5f910) << 12 + 8 and + 0xc at 0x38da..0x3902; 0x3864 then drains the
+# receive FIFO (status bit 2) through the data register.
+# The peers are the companion's two transfer routines, with the X-T5 command sets on
+# other chip selects: 0xc3c4 drives GPIO 0x000c0008 (port 12, pin 8) low around a
+# transfer and carries the BIS configuration sequence (09, 01 vv, 02 vv, 0b 05, 1c 4b,
+# reads a1/a2 storing the reply's low nibble, from 0x12446); 0xc430 drives 0x000c0009
+# (port 12, pin 9) low and its 18 callers send the LSM6DS-class register writes. The parts
+# are the existing explicit models; revision nibbles and idle MISO are the X-T5's
+# inherited scenario inputs, not X-H2 measurements. source_hz is the X-T5 value,
+# UNVERIFIED.
+# Interrupt output: the SSP setup 0x20ce4 unmasks all four interrupts (+0x14 = 0xf at
+# 0x20da2), but the companion never enables an NVIC line for this instance. Its only
+# NVIC enable 0x2e90 is reached only through the handler attach 0x1e160 (via 0x24738),
+# whose eight callers take their line from the interrupt table 0x31180: the mailbox (55,
+# 0x38be), entries 1 (58, 0x3022), 0x43 (0, 0x1ec1e) and 0x45 (63, the input-capture
+# handler 0x31f9 at 0x324a and 0x3dda), the DMA channel lines (83 + channel, map 0x3162c;
+# 0x1e42c, 0x1e57c) and the channel lines of the 0xff908000 block (map 0x3185c; 0x21aae).
+# No pending-register (ISPR) read exists, so the raised output is not observable by this
+# firmware and is declared unconnected. Which NVIC line the silicon wires it to is
+# unknown, UNVERIFIED.
+# DMA requests: the companion's channel descriptors 0x3166c + 12 * i (lookup 0x1ff0c) are
+# [channel, request, ...]: 0a 0b (channel 10, transmit, request 11) and 0b 0a (channel 11,
+# receive, request 10); the DMA start 0x1f8a4 passes byte 1 to the routing writer 0x1f770,
+# which stores it at 0xff90e500 + 4 * (channel >> 1). The transmit channel writes this
+# instance's data register +8. The X-T5 companion's SSP1 descriptors 0x32060/0x3206c
+# hold requests 3/2 on the same channels, so instance n uses 2n (receive) and 2n + 1.
+[[device]]
+base = 0xff915000
+size = 0x1000
+kind = "pl022"
+[device.options]
+source_hz = 48000000
+ticks_per_second = 1000000000
+receive_request = 10
+transmit_request = 11
+companion_irq_unconnected = true
+[device.options.wire]
+kind = "gpio-selected"
+[[device.options.wire.endpoints]]
+[device.options.wire.endpoints.select]
+port = 12
+pin = 8
+active_high = false
+[device.options.wire.endpoints.part]
+kind = "bis-configuration-registers"
+revision = [0, 0]
+samples = [0, 0]
+idle_high = false
+# A body at rest: the 0a..0f block (command 8a) reads zero, as before it became
+# a declared input.
+block = [0, 0, 0, 0, 0, 0]
+[[device.options.wire.endpoints]]
+[device.options.wire.endpoints.select]
+port = 12
+pin = 9
+active_high = false
+[device.options.wire.endpoints.part]
+kind = "lsm6ds-configuration-registers"
+temperature = 0
+# A still body: zero angular rate and acceleration (the model main read before
+# motion became a declared input).
+motion = { angular_rate = [0, 0, 0], acceleration = [0, 0, 0] }
diff --git a/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/63-power-gates.toml b/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/63-power-gates.toml
