diff --git a/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/10-timer.toml b/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/10-timer.toml
new file mode 100644
index 00000000..0b42363a
--- /dev/null
+++ b/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/10-timer.toml
@@ -0,0 +1,12 @@
+# The XP5 timer block (the SoC's `timer` and `extended-timer` blocks). The kernel's
+# counter helper 0x5d068 reads reload channel 15's current word 0xff908388 (channel n
+# at 0xff908310 + 8*n, enables at 0xff908300); 0x5b398 programs it for the RTOS tick.
+[[device]]
+base = 0xff908000
+size = 0x1000
+kind = "timer-focus-capture"
+
+[[device]]
+base = 0xff909000
+size = 0x1000
+kind = "timer-extended"
diff --git a/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/20-storage.toml b/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/20-storage.toml
new file mode 100644
index 00000000..5fe08c50
--- /dev/null
+++ b/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/20-storage.toml
@@ -0,0 +1,30 @@
+# Original XOR-DAT payload at the selected aperture 0xf0000000+0x08000000; the
+# camera-specific missing tail starts erased. One backing is shared with the serial
+# flash controller; CPU aperture stores fail.
+[[device]]
+base = 0xf0000000
+size = 0x08000000
+kind = "flash-storage"
+[device.options]
+dat_origin = 0x274
+xor = 0xff
+erased_tail = 0xff
+
+# Controller bank 0xff90a000 (decoder 0x13883ec, FIFO +0x80, request +0xd0). The
+# retained boot ID 0x2c5b1b (hardware info +0x5dc, kernel copy 0xa4b64) selects
+# descriptor row 0x1c50fa0 through 0x1387870 -> 0x1387214: Micron MT35XU01GBBA,
+# 128 MiB serial NOR, the X100VI and X-H2S part.
+[[device]]
+base = 0xff90a000
+size = 0x1000
+kind = "flash-storage-controller"
+[device.options]
+jedec_id = 0x2c5b1b
+# The part as the boot ROM and setup stage leave it; the board starts at the kernel,
+# after both. The application takes the ID from the retained tuple (0x1386714), not
+# through the fresh-ID initializer 0x1387c94 that calls device initializer 0x1388288,
+# whose volatile-register write (WREN, 0x81, byte 0x14 at register 1) selects 20.
+# Read setup 0x13875b0 programs aperture read 0xfd with 20 dummy cycles (+0x44,
+# +0x74 = 0x14), and the board reaches the first aperture read with no write to the
+# part: its volatile register already selects 20 dummy cycles.
+inherited_dummy_cycles = 20
diff --git a/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/21-clock-gates.toml b/catalog/firmware/xh2/5.33/xp5-boot/manifest.d/21-clock-gates.toml
